# Copy to .env; replace placeholders. Shopify credentials are used only by the backend.
SHOPIFY_STORE_DOMAIN=demo-analytics-poc.myshopify.com
SHOPIFY_CLIENT_ID=replace-with-client-id
SHOPIFY_CLIENT_SECRET=replace-with-client-secret
SHOPIFY_API_VERSION=2026-10
POSTGRES_DB=shopify_analytics
POSTGRES_USER=shopify_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Separate SELECT-only dashboard login; use a different random 20+ character password.
DASHBOARD_DB_PASSWORD=replace-with-a-separate-long-random-password

# Independent 32+ character random backend trigger secret. Shared with Streamlit server only.
PIPELINE_TRIGGER_TOKEN=replace-with-an-independent-random-trigger-secret
